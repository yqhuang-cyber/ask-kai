# Independent local POC. Business interfaces use mock HSKai by default.
ASK_KAI_HOST=127.0.0.1
ASK_KAI_PORT=4310
ASK_KAI_BACKEND=mock
# Disconnected voice preview; /dev/replay remains explicitly synthetic.
# Change to doubao after setting the key and reviewed profile below.
ASK_KAI_PROVIDER=replay

# Step 2 probe only. Create a reviewed profile after obtaining the full API spec.
# Keys stay in your local .env; never put them in a profile or send them in chat.
# Copy docs/protocol/seeduplex-profile.template.json to this path and review it.
# DOUBAO_PROBE_PROFILE=./.local/seeduplex-profile.json
# DOUBAO_API_KEY=
# Web realtime requires a separately reviewed complete audio/event profile.
# DOUBAO_REALTIME_PROFILE=./.local/seeduplex-profile.json
# Seeduplex protocol review, ACK-order review and live acceptance are separate.
# See docs/protocol/seeduplex-integration.md; do not mark review flags automatically.
# POC creates its local mock service and signing secret automatically.
# No HSKai repository, account, endpoint or secret is required.
# The following are only for a future, explicit ASK_KAI_BACKEND=external setup.
# Mock mode ignores these external settings.
# HSKAI_BRIDGE_SECRET=
# HSKAI_ALLOWED_MARKETS=SG
# HSKAI_MEMORY_ENDPOINT=https://your-hskai-host/internal/ask-kai/memory
# HSKAI_SAFEGUARDING_ENDPOINT=https://your-hskai-host/internal/ask-kai/safeguarding
# HSKAI_PRIVACY_ENDPOINT=https://your-hskai-host/internal/ask-kai/privacy
ASK_KAI_RELEASE_MODE=internal
# EVAL_JUDGE_BASE_URL=https://your-reviewed-judge-endpoint/v1
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_MODEL=
# EVAL_JUDGE_VERSION=
# LANGFUSE_BASE_URL=https://your-langfuse-host
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_TRACE_MAP=./.local/trace-map.json
# EVAL_RUN_ID=
# ASK_KAI_RELEASE_EVIDENCE=./.local/release-evidence.json
# ASK_KAI_CONTENT_REPORT=./.local/content-report.json
# ASK_KAI_CANDIDATE_REVISION=
